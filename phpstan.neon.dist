includes:
  - %rootDir%/conf/bleedingEdge.neon

parameters:
  level: max
  checkMissingCallableSignature: true
  tipsOfTheDay: false
  errorFormat: compact
  parallel:
    maximumNumberOfProcesses: 7
  paths:
    - src
    - tests
  excludePaths:
    - tests/**/data/*.php
  scanDirectories:
      - vendor/squizlabs/php_codesniffer/src
  stubFiles:
    - stubs/FixerInterface.stub
    - stubs/ConfigurableFixerInterface.stub
  # Sniffs run on php_codesniffer 3 and 4, which differ on deprecations and nullability
  reportUnmatchedIgnoredErrors: false
  ignoreErrors:
    - identifier: staticProperty.deprecated
      path: src/*
    - identifier: property.deprecated
      path: src/*
    - identifier: identical.alwaysFalse
      path: src/*
    - identifier: cast.useless
      path: src/*
